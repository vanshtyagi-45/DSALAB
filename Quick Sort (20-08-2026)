#include <stdio.h>
void quicksort(int a[], int low, int high)
{
    int i, j, x, y;
    if (low < high)
    {
        i = low;
        j = high;
        x = a[low];
        while (i < j)
        {
            while (a[i] <= x && i < high)
                i++;
            while (a[j] > x)
                j--;
            if (i < j)
            {
                y = a[i];
                a[i] = a[j];
                a[j] = y;
            }
        }
        a[low] = a[j];
        a[j] = x;
        quicksort(a, low, j - 1);
        quicksort(a, j + 1, high);
    }
}
int main()
{
    int a[] = {5, 2, 8, 1, 3};
    int i;
    quicksort(a, 0, 4);
    for (i = 0; i < 5; i++)
        printf("%d ", a[i]);
    return 0;
}
