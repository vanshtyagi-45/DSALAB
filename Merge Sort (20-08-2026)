#include <stdio.h>

void merge(int a[],int l,int m,int r){
    int x=l,y=m+1,k=0,b[100];
    while(x<=m&&y<=r)
        b[k++]=(a[x]<a[y])?a[x++]:a[y++];
    while(x<=m)b[k++]=a[x++];
    while(y<=r)b[k++]=a[y++];
    for(x=l,k=0;x<=r;x++,k++)a[x]=b[k];
}

void sort(int a[],int l,int r){
    if(l<r){
        int m=(l+r)/2;
        sort(a,l,m);
        sort(a,m+1,r);
        merge(a,l,m,r);
    }
}

int main(){
    int a[]={5,2,8,1,3},n=5,x;
    sort(a,0,n-1);
    for(x=0;x<n;x++)printf("%d ",a[x]);
    return 0;
}
